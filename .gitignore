# Data & Models
# Keep large bulk archive and other subsets (FD002/3/4) out of git,
# but include the official NASA FD001 dataset text files so cloud builds have them immediately.
data/raw/*
!data/raw/.gitkeep
!data/raw/train_FD001.txt
!data/raw/test_FD001.txt
!data/raw/RUL_FD001.txt
!data/raw/readme.txt
data/processed/*
!data/processed/.gitkeep
ml/models/*.joblib
ml/models/*.pkl
!ml/models/.gitkeep

# Environment variables & secrets
.env
*.env
!.env.example

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

