# =====================================================================
# Nex Aero Backend - Environment Configuration Example (Free Tier)
# =====================================================================

HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
# Set to your deployed Vercel domain on Render:
CORS_ORIGINS=https://nex-aero.vercel.app,http://localhost:5173

# Database Connection (Free Tier Ephemeral Local SQLite)
DATABASE_URL=sqlite:///./data/nex_aero.db

# Machine Learning Artifact Paths
MODEL_PATH=ml/models/rf_fd001_pipeline.joblib
METADATA_PATH=ml/models/rf_fd001_metadata.json
