# Nex Aero Frontend - Environment Configuration

# Backend API Base URL
# For local development with FastAPI running on port 8000:
# VITE_API_BASE_URL=http://localhost:8000

# For production deployment on Vercel pointing to Render:
VITE_API_BASE_URL=https://nex-aero-api.onrender.com

# Request timeout in milliseconds (default: 20000ms / 20 seconds)
VITE_API_TIMEOUT_MS=20000
