# =====================================================================
# Nex Aero - Root Environment Configuration Example (100% Free Hosting)
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
# In production on Render, set this to your Vercel frontend URL:
CORS_ORIGINS=https://nex-aero.vercel.app,http://localhost:5173,http://localhost:3000

# Database Connection URL (Free Tier: Writable Local SQLite)
# Ephemeral local database inside writable application directory:
DATABASE_URL=sqlite:///./data/nex_aero.db
# Alternative Linux ephemeral location:
# DATABASE_URL=sqlite:////tmp/nex_aero.db

# Model Paths
MODEL_PATH=ml/models/rf_fd001_pipeline.joblib
METADATA_PATH=ml/models/rf_fd001_metadata.json

# Demo Thresholds (illustrative maintenance review boundaries)
CRITICAL_RUL_THRESHOLD=25
WARNING_RUL_THRESHOLD=50
MODERATE_RUL_THRESHOLD=80

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=45000
